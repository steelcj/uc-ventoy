[Unit]
Description=Raw node first boot: hostname suffix and confirmation report
Documentation=file:/usr/local/sbin/raw-node-firstboot
Wants=network-online.target
# cloud-init creates the initial user in its network stage, which is named
# cloud-init.service on Ubuntu 24.04 and cloud-init-network.service on 26.04.
After=network-online.target cloud-init.service cloud-init-network.service
ConditionPathExists=!/var/lib/raw-node/confirmation.yml

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/raw-node-firstboot
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
