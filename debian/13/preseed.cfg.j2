#_preseed_V1
# Debian 13 raw node answer file.
# Generated by bin/build from debian/13/preseed.cfg.j2. Do not edit the output.

### Localization

d-i debian-installer/locale string en_CA.UTF-8
d-i keyboard-configuration/xkb-keymap select us

### Network

d-i netcfg/choose_interface select auto
d-i netcfg/get_hostname string {{ hostname_base }}
d-i netcfg/get_domain string home.arpa
d-i netcfg/hostname string {{ hostname_base }}

### Mirror

d-i mirror/country string manual
d-i mirror/http/hostname string deb.debian.org
d-i mirror/http/directory string /debian
d-i mirror/http/proxy string

### Clock and time zone

d-i clock-setup/utc boolean true
d-i time/zone string America/Toronto
d-i clock-setup/ntp boolean true

### Root account

d-i passwd/root-login boolean true
d-i passwd/root-password-crypted password {{ root_password_hash }}

### Initial user

d-i passwd/make-user boolean true
d-i passwd/user-fullname string Initial User
d-i passwd/username string {{ initial_username }}
d-i passwd/user-password-crypted password {{ initial_password_hash }}

### Partitioning

# Deliberately not preseeded. The partitioner stops for manual confirmation.

### Package selection

tasksel tasksel/first multiselect standard, ssh-server
d-i pkgsel/include string sudo nftables python3 foomuuri
d-i pkgsel/upgrade select none
d-i pkgsel/update-policy select none
popularity-contest popularity-contest/participate boolean false

### Boot loader

d-i grub-installer/only_debian boolean true

### Firewall

# Every raw node gets the same Foomuuri firewall, rendered by bin/build from
# shared/foomuuri/00-raw-node.conf.j2. nftables.service is masked because its
# stop action flushes the whole ruleset. foomuuri.service starts
# foomuuri-boot.service by itself, so only foomuuri.service is enabled.

### Post-install configuration

d-i preseed/late_command string \
    in-target usermod -aG sudo {{ initial_username }}; \
    in-target install -d -m 0700 -o {{ initial_username }} -g {{ initial_username }} /home/{{ initial_username }}/.ssh; \
    printf '%s\n' '{{ ssh_public_key }}' > /target/home/{{ initial_username }}/.ssh/authorized_keys; \
    in-target chown {{ initial_username }}:{{ initial_username }} /home/{{ initial_username }}/.ssh/authorized_keys; \
    in-target chmod 0600 /home/{{ initial_username }}/.ssh/authorized_keys; \
{{ write("shared/ssh/10-local-auth.conf", "/etc/ssh/sshd_config.d/10-local-auth.conf", "0644") }}
{{ write_text(ssh_port_conf, "/etc/ssh/sshd_config.d/20-raw-node-port.conf", "0644") }}
{{ write_text(foomuuri_conf, "/etc/foomuuri/00-raw-node.conf", "0644") }}
{{ write("shared/bin/raw-node-report", "/usr/local/sbin/raw-node-report", "0755") }}
{{ write("shared/bin/raw-node-firstboot", "/usr/local/sbin/raw-node-firstboot", "0755") }}
{{ write("shared/systemd/raw-node-firstboot.service", "/etc/systemd/system/raw-node-firstboot.service", "0644") }}
{{ write_text(raw_node_conf, "/etc/raw-node/raw-node.conf", "0644") }}
    in-target systemctl mask nftables.service; \
    in-target systemctl enable foomuuri.service raw-node-firstboot.service

### Finish

d-i finish-install/reboot_in_progress note
